# Kiosk UI (client/) — browser-safe vars only (must be prefixed with VITE_)
# Copy: cp client/.env.example client/.env

# WebRTC offer endpoint on the voice bot
VITE_BOT_OFFER_URL=http://127.0.0.1:7860/api/offer

# Platform API (identity, history persist, OCR, summary, follow-ups)
# Use this once P1/P2 APIs are wired from the kiosk
VITE_API_BASE_URL=http://127.0.0.1:8000
